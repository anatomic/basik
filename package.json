{
  "name": "BASIK",
  "version": "2.0.0",
  "description": "BASIK - Build A School In Kenya (Astro)",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:astro": "astro dev",
    "dev:js": "esbuild src/js/main.js --bundle --outfile=public/js/main.js --format=esm --watch",
    "build": "run-s lint build:js build:astro",
    "build:astro": "astro build",
    "build:js": "esbuild src/js/main.js --bundle --minify --outfile=public/js/main.js --format=esm",
    "preview": "astro preview",
    "lint": "eslint .",
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatomic/basik.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anatomic/basik/issues"
  },
  "homepage": "https://github.com/anatomic/basik#readme",
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tailwindplus/elements": "^1.0.21",
    "astro": "^5.8.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18"
  }
}
