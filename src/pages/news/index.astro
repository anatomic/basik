---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Check if we're in production (Netlify sets CONTEXT=production)
const isProduction = import.meta.env.PROD;

// Get all blog posts
const allPosts = await getCollection("blog");

// Filter and sort posts
const now = new Date();
const posts = allPosts
  .filter((post) => {
    if (isProduction) {
      // In production, post must be published AND have a past/current date
      const isPublished = post.data.published === true;
      const isDatePassed = new Date(post.data.date) <= now;
      return isPublished && isDatePassed;
    }
    // In non-production environments, show all posts
    return true;
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Date formatting helpers
const dateFormat = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
const isoDate = (date: Date) => date.toISOString().split("T")[0];
const isFutureDate = (date: Date) => date > new Date();
---

<BaseLayout
  title="News & Updates"
  description="The latest news and updates from BASIK - Build A School In Kenya."
>
  <div class="bg-white py-24 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1
          class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          News & Updates
        </h1>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
          Stay up to date with our latest projects, events, and stories from
          Kenya.
        </p>
      </div>

      {
        posts.length > 0 ? (
          <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 lg:mx-0 lg:max-w-none lg:grid-cols-3">
            {posts.map((post) => (
              <article class="flex flex-col items-start">
                {post.data.image && (
                  <a href={`/news/${post.id}/`} class="relative w-full">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="aspect-video w-full rounded-2xl bg-gray-100 object-cover dark:bg-gray-800"
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="max-w-xl">
                  <div class="mt-6 flex items-center gap-x-4 text-xs">
                    <time
                      datetime={isoDate(post.data.date)}
                      class="text-gray-600 dark:text-gray-400"
                    >
                      {dateFormat(post.data.date)}
                    </time>
                    {!isProduction && (
                      <>
                        {!post.data.published && (
                          <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2.5 py-1 font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-300">
                            <svg
                              class="h-3.5 w-3.5"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                              />
                            </svg>
                            Draft
                          </span>
                        )}
                        {post.data.published && isFutureDate(post.data.date) && (
                          <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-1 font-medium text-amber-800 dark:bg-amber-900/50 dark:text-amber-300">
                            <svg
                              class="h-3.5 w-3.5"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                              />
                            </svg>
                            Scheduled
                          </span>
                        )}
                      </>
                    )}
                    {post.data.tags &&
                      post.data.tags.slice(0, 2).map((tag) => (
                        <span class="rounded-full bg-orange-50 px-3 py-1.5 font-medium text-orange-600 dark:bg-orange-900/30 dark:text-orange-400">
                          {tag}
                        </span>
                      ))}
                  </div>
                  <div class="group relative">
                    <h2 class="mt-3 text-lg font-semibold text-gray-900 group-hover:text-orange-600 dark:text-white dark:group-hover:text-orange-400">
                      <a href={`/news/${post.id}/`}>
                        <span class="absolute inset-0" />
                        {post.data.title}
                      </a>
                    </h2>
                    {post.data.summary && (
                      <p class="mt-3 line-clamp-3 text-sm text-gray-600 dark:text-gray-300">
                        {post.data.summary}
                      </p>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="mx-auto mt-16 max-w-2xl text-center">
            <p class="text-gray-600 dark:text-gray-400">
              No news posts yet. Check back soon!
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
